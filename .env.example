# Copy this file to .env and fill in the values. Never commit .env.

# Gemini: understanding, photo/document reading, speech-to-text and text-to-speech
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Twilio: WhatsApp sandbox, voice calls, SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=
TWILIO_SMS_FROM=

# Public URL of this server (the ngrok https URL). Needed for voice replies and phone calls.
PUBLIC_BASE_URL=

# Where the agent finds the PMFBY service. Default is the built-in mock.
PMFBY_BASE_URL=http://127.0.0.1:8000/mock

# Hours an official has to forward a report onward before the agent escalates.
HANDOFF_WINDOW_HOURS=48
